# Local PostgreSQL settings for Docker Compose. Do not commit a populated .env.
POSTGRES_DB=enterprise_support
POSTGRES_USER=enterprise_support
POSTGRES_PASSWORD=change-me-for-local-development

# Maximum accepted multipart PDF upload size in bytes (default: 25 MiB).
DOCUMENT_UPLOAD_MAX_BYTES=26214400

# Comma-separated local frontend development origins. Do not use a wildcard when
# document upload/deletion endpoints remain unauthenticated.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Grounded generation defaults to the offline Mock provider. To use an already-installed
# local Ollama model, set RAG_PROVIDER=ollama and configure its model name and local endpoint.
RAG_PROVIDER=mock
# OLLAMA_MODEL=your-already-installed-local-model
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_TIMEOUT_SECONDS=30
# For an explicitly authorised private-network Ollama host only, this must exactly match OLLAMA_BASE_URL.
# Selected evidence is sent to that host; never set it for an untrusted endpoint.
# OLLAMA_TRUSTED_BASE_URL=http://approved-private-host:11434
